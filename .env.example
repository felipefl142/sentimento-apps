# Caminhos (default: ./data, ./reports) - use para rodar o pipeline num diretorio isolado
# DATA_DIR=/tmp/sentimento/data
# REPORTS_DIR=/tmp/sentimento/reports

# MLflow (default: sqlite local ./mlflow.db + artefatos em ./mlartifacts)
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_EXPERIMENT=sentimento-apps
MLFLOW_DISABLE_AGENT_HINT=1

# Google Play (scraper): pausa entre paginas, tentativas com backoff
HTTP_DELAY=0.5
HTTP_RETRIES=4
HTTP_TIMEOUT=30

# Transformers: cpu forca CPU mesmo com GPU disponivel
# DEVICE=cuda
TOKENIZERS_PARALLELISM=false
